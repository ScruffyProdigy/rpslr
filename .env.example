# ============================================================================
# JoinQuest Demo Game — Rock Paper Scissors
# Copy to .env and adjust as needed:  cp .env.example .env
# ============================================================================
# This game runs INDEPENDENTLY from the JoinQuest Lobby platform.
# It uses its own ports and its own database to avoid Lobby collisions.
#
# Port plan (do NOT collide with Lobby):
#   | Service        | This Game | Lobby (other repo) |
#   |----------------|-----------|--------------------|
#   | Frontend       | 5174      | 5173               |
#   | API            | 3001      | 8080               |
#   | Postgres       | 5433      | 5432               |
# ============================================================================

# ---- Environment ------------------------------------------------------------
GAME_APP_ENV=local           # local | staging | production

# ---- Game API (api/) --------------------------------------------------------
API_PORT=3001
# Seat JWT `aud` must match this origin (defaults to GAME_API_BASE_URL below).
# Local: http://localhost:3001 — GKE production: https://rpsls-duel.win (origin only; paths are /api/v1/...)
# GAME_API_AUDIENCE=http://localhost:3001
# CORS: comma-separated list of allowed origins (Lobby dev origins included)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Where the API fetches the SPA shell for /replay link previews. Defaults to
# GAME_PLAY_URL; in Kubernetes it is the in-cluster client service.
# GAME_CLIENT_ORIGIN=http://localhost:5174

# ---- Game database (separate Postgres) --------------------------------------
# Host port for the game's Postgres. Default 5433 avoids Lobby's 5432, but if
# something else already holds 5433 (e.g. an SSH tunnel), just change this to a
# free port like 5434 — docker-compose, the scripts, and the DSN all read it.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_USER=rps
POSTGRES_PASSWORD=rps_dev_password
POSTGRES_DB=rps_game
# DATABASE_URL is derived from the POSTGRES_* values above (POSTGRES_PORT is the
# single source of truth). Uncomment to point at an external DB instead:
# DATABASE_URL=postgres://rps:rps_dev_password@localhost:5433/rps_game

# ---- Game client (client/) — injected into window.env via /env.js -----------
GAME_API_BASE_URL=http://localhost:3001
# Browser play URL Lobby uses for launch links (must match catalog playUrl).
GAME_PLAY_URL=http://localhost:5174
# Live gameplay uses a WebSocket at <api>/api/v1/ws. The client derives the ws
# URL from GAME_API_BASE_URL (http->ws, https->wss). Set this only to override
# (e.g. a separate ws host). Leave blank to use the derived default.
GAME_WS_BASE_URL=

# Where a replay's "Play RPSLR on JoinQuest" button sends a watcher. Blank
# falls back to the game's page on joinquest.cc.
GAME_LOBBY_URL=

# ---- Lobby integration (push model "option 2" — see docs/joinquest-integration.md) ----
# Lobby provisions a match server-to-server (POST /api/v1/matches with an
# assignment), then links each user with a signed JWT proving their seat.
# When REQUIRE_LOBBY_AUTH=true, claiming a seat REQUIRES a valid Bearer JWT
# verified against Lobby's JWKS. For the v1 standalone demo this is false and
# the UI shows a "standalone mode" banner (self-serve room codes).
REQUIRE_LOBBY_AUTH=false
# Lobby GraphQL auth: each provision includes `lobby.serviceToken` (per-game v1.{gameId}.{sig}
# when Lobby sets LOBBY_GAME_TOKEN_PEPPER). Stored on the match; optional in local dev.

# Roster rejection handshake: comma-separated Lobby user ids this game refuses
# to host. A push (POST /api/v1/matches) whose roster includes any of these is
# rejected with HTTP 403 + { bannedLobbyUserIds: [...] } so Lobby can correct.
BANNED_LOBBY_USERS=
